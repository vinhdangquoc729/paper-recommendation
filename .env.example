# Semantic Scholar API key (không bắt buộc nhưng nên có)
S2_API_KEY=

# Tài khoản OpenReview (bắt buộc cho `python -m crawler openreview`)
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# Postgres của sản phẩm (docker compose). Không đặt thì dùng mặc định paperrec / cổng 55432
# POSTGRES_PASSWORD=
# POSTGRES_PORT=55432
# DATABASE_URL=postgresql://paperrec:paperrec@localhost:55432/paperrec
